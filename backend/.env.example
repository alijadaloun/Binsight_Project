PORT=3000
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=binsightdb
DB_USER=root
DB_PASSWORD=
DATA_STALE_AFTER_MINUTES=1440
# A bin at or above this fill percentage is full. Below it counts as below capacity.
FULL_FILL_PERCENTAGE=70
# Tilt from upright, in degrees, at which a bin is stored and shown as fallen.
FALLEN_TILT_DEGREES=45
# Read-only ThingSpeak channel. Hardware writes field1=fill, field2=gas, field3=tilt.
# Leave the read key empty to disable polling. Do not put the channel write key here.
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=
THINGSPEAK_BIN_ID=BIN_001
THINGSPEAK_POLL_SECONDS=20
# Set a random value of at least 32 characters before accepting external ingestion.
INGEST_API_KEY=
# For a one-cluster SMS test, use the exact sender number forwarded by the Android app.
SMS_SENDER_NUMBER=
SMS_CLUSTER_ID=
